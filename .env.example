# Copy to .env and fill in real values. Never commit a real .env.
#
# Legacy CLI fallback (used when no model profile is selected):
#   OPENAI_API_KEY and OPENAI_MODEL are required; OPENAI_BASE_URL is optional
#   and only needed for OpenAI-compatible gateways.
# CLI fallback with a profile: OPENAI_* may be omitted entirely.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=your-model-name
OPENAI_BASE_URL=https://api.openai.com/v1

# User-level config directory (default ~/.coding-agent). config.json and
# credentials.json live here and are never written into a workspace.
# CODING_AGENT_HOME=C:/Users/you/.coding-agent

# Credential refs can be provided via environment too; the ref "openai"
# maps to OPENAI_API_KEY, any other ref <name> maps to CODING_AGENT_CRED_<NAME>.
# When the environment provides a ref, GUI writes for it are disabled.
# CODING_AGENT_CRED_DEEPSEEK=sk-your-deepseek-key
