{
  "name": "coding-agent-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend of the local Coding Agent GUI (React/TypeScript/Vite).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
